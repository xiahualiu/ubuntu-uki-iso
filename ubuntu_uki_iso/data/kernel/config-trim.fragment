# ---------------------------------------------------------------------------
# SCSI — the midlayer stays, the host bus adapters go
# ---------------------------------------------------------------------------
# The midlayer is load-bearing and cannot be removed: libata sits on top of it,
# so `# CONFIG_SCSI is not set` would take the SATA array with it. What is
# optional is the layer above — the HBA drivers themselves — and it is disabled
# here as a block.
#
# This is a menu gate, and an earlier version of this file avoided it for
# exactly that reason: disabling SCSI_LOWLEVEL removes everything inside its
# block, including symbols it never names. That is how SCSI_VIRTIO was lost,
# back when the QEMU harness needed it for its data disks. The harness puts
# those on AHCI now, so nothing in here is used, and the gate is the honest way
# to say so.
#
# What was checked to survive, by configuring both ways and diffing:
#
#   CONFIG_SCSI=y           the midlayer
#   CONFIG_BLK_DEV_SD=y     SCSI disks — the USB stick the ISO boots from
#   CONFIG_BLK_DEV_SR=y     SCSI CD-ROM — not the primary path any more, kept
#                           because it costs nothing and leaves CD boot working
#   CONFIG_ATA=y            libata, which is not inside this block
#   CONFIG_SATA_AHCI=m      the eight data disks
#   CONFIG_BLK_DEV_NVME=m   the root disk; NVMe is not SCSI at all
#   CONFIG_MD_RAID0=m       the array
#   CONFIG_USB_STORAGE=m    USB mass storage; the live medium arrives that way
#
# If one of those ever stops surviving, this gate has grown to cover more than
# it used to and the list above is where to look.

# CONFIG_SCSI_LOWLEVEL is not set

# ---------------------------------------------------------------------------
# DRM — nouveau only
# ---------------------------------------------------------------------------
# The GPU is a TU104 (RTX 2080) and the only DRM driver kept. Everything else
# is a driver for a GPU that is not in this machine.
#
# DRM_SIMPLEDRM is deliberately NOT touched. It is not a hardware driver, it is
# the generic framebuffer that hands the EFI framebuffer to the console, and
# it is =y in the base config. Setting it off would cost the boot console
# before nouveau loads — which is the entire window where boot messages are
# visible, since nouveau is excluded from every initramfs.
#
# DRM_VIRTIO_GPU is off like the rest; tests/vm-test.sh drives QEMU over the
# serial console rather than a virtual display. Re-enable it here if you want
# to boot the ISO in a graphical VM.

# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_AST is not set
# CONFIG_DRM_GMA500 is not set
# CONFIG_DRM_HYPERV is not set
# CONFIG_DRM_I915 is not set
# CONFIG_DRM_MGAG200 is not set
# CONFIG_DRM_QXL is not set
# CONFIG_DRM_RADEON is not set
# CONFIG_DRM_BOCHS is not set
# CONFIG_DRM_CIRRUS_QEMU is not set
# CONFIG_DRM_GM12U320 is not set
# CONFIG_DRM_PIXPAPER is not set
# CONFIG_DRM_UDL is not set
# CONFIG_DRM_VBOXVIDEO is not set
# CONFIG_DRM_VGEM is not set
# CONFIG_DRM_VIRTIO_GPU is not set
# CONFIG_DRM_VKMS is not set
# CONFIG_DRM_VMWGFX is not set
# CONFIG_DRM_XE is not set
# CONFIG_DRM_XEN is not set
# CONFIG_DRM_XEN_FRONTEND is not set
# CONFIG_DRM_APPLETBDRM is not set
# CONFIG_DRM_GUD is not set
# CONFIG_DRM_SSD130X is not set
# CONFIG_DRM_PANEL is not set
# CONFIG_DRM_ANALOGIX_ANX78XX is not set
# CONFIG_DRM_ANALOGIX_DP is not set
# CONFIG_DRM_I2C_NXP_TDA998X is not set
# CONFIG_DRM_ACCEL is not set

# ---------------------------------------------------------------------------
# Filesystems not in use
# ---------------------------------------------------------------------------
# The root disk is ext4, the ESP is vfat, the array is ext4, and the ISO needs
# iso9660 + squashfs + overlayfs. Cluster/network filesystems are not in use.
#
# reiserfs is not listed: it was removed from the kernel entirely, so there is
# no symbol left to disable. `make check-config` reports lines like that, which
# is how this note came to exist.

# CONFIG_BTRFS_FS is not set
# CONFIG_GFS2_FS is not set
# CONFIG_OCFS2_FS is not set
# CONFIG_JFS_FS is not set
# CONFIG_NILFS2_FS is not set
# CONFIG_F2FS_FS is not set
